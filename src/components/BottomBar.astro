---
import { getSiteData } from '../lib/payload';

const siteData = await getSiteData();
---

<div class="bottom-bar">
  <div class="bottom-bar-content">
    <!-- Rezervace -->
    <a href="/rezervace" class="bottom-bar-item">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
      <span>REZERVACE</span>
    </a>

    <!-- Telefon -->
    <a href={`tel:${siteData.contact.phone}`} class="bottom-bar-item">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
      </svg>
      <span>{siteData.contact.phone}</span>
    </a>
  </div>
</div>

<style>
  .bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(74, 76, 88, 0.95);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 1000;
    padding: 12px 0;
  }

  .bottom-bar-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }

  .bottom-bar-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .bottom-bar-item:hover {
    color: #B8D4A8;
    transform: translateY(-1px);
  }

  .bottom-bar-item svg {
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .bottom-bar-content {
      gap: 24px;
    }

    .bottom-bar-item {
      font-size: 12px;
    }
  }

  @media (max-width: 768px) {
    .bottom-bar {
      position: static;
      padding: 12px 0;
    }

    .bottom-bar-content {
      flex-direction: column;
      gap: 12px;
      padding: 0 16px;
    }

    .bottom-bar-item {
      width: 100%;
      justify-content: center;
      padding: 8px;
    }
  }

  @media (max-width: 480px) {
    .bottom-bar-item span {
      font-size: 11px;
    }
  }

  /* Add padding to body to account for fixed bar */
  :global(body) {
    padding-bottom: 60px;
  }

  @media (max-width: 768px) {
    :global(body) {
      padding-bottom: 0;
    }
  }
</style>
